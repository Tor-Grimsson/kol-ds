{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "showcase/dist",
  "redirects": [
    {
      "source": "/apps/media-shell/:path*",
      "destination": "/apps/media-hub/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apps/media/(.*)",
      "destination": "/apps/media/index.html"
    },
    {
      "source": "/apps/media-hub/(.*)",
      "destination": "/apps/media-hub/index.html"
    },
    {
      "source": "/apps/hub/(.*)",
      "destination": "/apps/hub/index.html"
    },
    {
      "source": "/apps/notes/(.*)",
      "destination": "/apps/notes/index.html"
    },
    {
      "source": "/apps/presentation/(.*)",
      "destination": "/apps/presentation/index.html"
    },
    {
      "source": "/apps/brand/(.*)",
      "destination": "/apps/brand/index.html"
    },
    {
      "source": "/apps/editor/(.*)",
      "destination": "/apps/editor/index.html"
    },
    {
      "source": "/apps/controls/(.*)",
      "destination": "/apps/controls/index.html"
    },
    {
      "source": "/apps/curves/(.*)",
      "destination": "/apps/curves/index.html"
    },
    {
      "source": "/apps/shell/(.*)",
      "destination": "/apps/shell/index.html"
    },
    {
      "source": "/apps/notes-hub/(.*)",
      "destination": "/apps/notes-hub/index.html"
    },
    {
      "source": "/apps/presentation-hub/(.*)",
      "destination": "/apps/presentation-hub/index.html"
    },
    {
      "source": "/apps/catalog/(.*)",
      "destination": "/apps/catalog/index.html"
    },
    {
      "source": "/apps/studio/(.*)",
      "destination": "/apps/studio/index.html"
    },
    {
      "source": "/apps/panels/(.*)",
      "destination": "/apps/panels/index.html"
    },
    {
      "source": "/apps/fixtures/(.*)",
      "destination": "/apps/fixtures/index.html"
    },
    {
      "source": "/apps/brand-hub/(.*)",
      "destination": "/apps/brand-hub/index.html"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://r2.kolkrabbi.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
