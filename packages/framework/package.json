{
  "name": "@kolkrabbi/kol-framework",
  "version": "0.44.0",
  "description": "KOL app shell \u2014 sidenav, layout, theme toggle, footer, heroes + brand color layer. SideNav takes nav data as props so the tree stays app-local.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./kol-framework.css": "./kol-framework.css",
    "./kol-brand-color.css": "./kol-brand-color.css"
  },
  "peerDependencies": {
    "@kolkrabbi/kol-component": ">=0.177.0",
    "@kolkrabbi/kol-icons": ">=0.18.0",
    "@kolkrabbi/kol-theme": ">=0.138.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@kolkrabbi/kol-component": "workspace:^",
    "@kolkrabbi/kol-icons": "workspace:^"
  },
  "files": [
    "src",
    "*.css",
    "README.md"
  ],
  "keywords": [
    "kol",
    "kolkrabbi",
    "design-system",
    "react",
    "app-shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tor-Grimsson/kol-ds.git",
    "directory": "packages/framework"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ]
}
