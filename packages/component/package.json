{
  "name": "@kolkrabbi/kol-component",
  "version": "0.149.0",
  "description": "KOL design-system components — atoms through organisms, emitting canonical kol-* classes. Pairs with @kolkrabbi/kol-theme for styling.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./atoms/*": "./src/atoms/*.jsx",
    "./molecules/*": "./src/molecules/*.jsx",
    "./organisms/*": "./src/organisms/*.jsx",
    "./utilities/*": "./src/utilities/*.jsx",
    "./utilities/id3": "./src/utilities/id3.js",
    "./utilities/frontmatter": "./src/utilities/frontmatter.js",
    "./utilities/markdownToHtml": "./src/utilities/markdownToHtml.js",
    "./utilities/mediaKinds": "./src/utilities/mediaKinds.js",
    "./utilities/ratios": "./src/utilities/ratios.js",
    "./utilities/motion": "./src/utilities/motion.js",
    "./hooks/*": "./src/hooks/*.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "embla-carousel-react": "^8.6.0",
    "react-syntax-highlighter": "^16.1.1"
  },
  "peerDependencies": {
    "@kolkrabbi/kol-icons": ">=0.22.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.13.0",
    "hls.js": "^1.6.0",
    "opentype.js": "^1.3.4 || ^2.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@kolkrabbi/kol-icons": "workspace:^"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "kol",
    "kolkrabbi",
    "design-system",
    "react",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tor-Grimsson/kol-ds.git",
    "directory": "packages/component"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "opentype.js": {
      "optional": true
    }
  }
}
