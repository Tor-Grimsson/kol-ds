  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*"
  },
  "peerDependencies": {
    "@kolkrabbi/kol-component": ">=0.156.0",
    "@kolkrabbi/kol-icons": ">=0.25.0",
    "@kolkrabbi/kol-theme": ">=0.124.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kolkrabbi/kol-component": "workspace:^",
    "@kolkrabbi/kol-icons": "workspace:^",
    "@kolkrabbi/kol-theme": "workspace:^"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "kol",
    "kolkrabbi",
    "design-system",
